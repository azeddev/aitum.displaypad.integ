<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenBaseCamp.App.ViewModels"
             xmlns:views="using:OpenBaseCamp.App.Views"
             xmlns:core="using:OpenBaseCamp.Core.Model"
             xmlns:actions="using:OpenBaseCamp.Core.Actions"
             xmlns:aitum="using:OpenBaseCamp.Core.Integrations.Aitum"
             x:Class="OpenBaseCamp.App.Views.KeyInspector"
             x:DataType="vm:KeyEditorViewModel">

  <UserControl.Resources>
    <views:HexToBrushConverter x:Key="HexBrush" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="6">

      <TextBlock Text="Key" Classes="h1" />

      <TextBlock Text="Category" Classes="h2" />
      <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch" />

      <TextBlock Text="Action" Classes="h2" />
      <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="actions:ActionDescriptor">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding SelectedAction.Description}" Classes="hint" Margin="0,2,0,0" />

      <!-- Hotkey -->
      <StackPanel Spacing="6" IsVisible="{Binding IsHotkey}">
        <TextBlock Text="Modifiers" Classes="h2" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <CheckBox Content="Ctrl" IsChecked="{Binding ModifierControl}" />
          <CheckBox Content="Shift" IsChecked="{Binding ModifierShift}" />
          <CheckBox Content="Alt" IsChecked="{Binding ModifierAlt}" />
          <CheckBox Content="Win" IsChecked="{Binding ModifierWindows}" />
        </StackPanel>
        <TextBlock Text="Key" Classes="h2" />
        <ComboBox ItemsSource="{Binding HotkeyKeys}" SelectedItem="{Binding HotkeyKey}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:KeyCodeEntry">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Text -->
      <StackPanel Spacing="6" IsVisible="{Binding IsText}">
        <TextBlock Text="Text to type" Classes="h2" />
        <TextBox Text="{Binding Text}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" />
        <CheckBox Content="Press Enter afterwards" IsChecked="{Binding PressEnterAfterText}" />
      </StackPanel>

      <!-- Macro -->
      <StackPanel Spacing="6" IsVisible="{Binding IsMacro}">
        <TextBlock Text="Macro" Classes="h2" />
        <TextBlock Text="{Binding MacroSummary}" Classes="hint" />
        <Button Content="Edit macro…" Command="{Binding EditMacroCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Mouse -->
      <StackPanel Spacing="6" IsVisible="{Binding IsMouse}">
        <TextBlock Text="Mouse action" Classes="h2" />
        <ComboBox ItemsSource="{Binding MouseCommands}" SelectedItem="{Binding MouseCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Multimedia -->
      <StackPanel Spacing="6" IsVisible="{Binding IsMultimedia}">
        <TextBlock Text="Multimedia key" Classes="h2" />
        <ComboBox ItemsSource="{Binding MultimediaCommands}" SelectedItem="{Binding MultimediaCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Volume -->
      <StackPanel Spacing="6" IsVisible="{Binding IsVolume}">
        <TextBlock Text="Volume action" Classes="h2" />
        <ComboBox ItemsSource="{Binding VolumeCommands}" SelectedItem="{Binding VolumeCommand}" HorizontalAlignment="Stretch" />
        <StackPanel Spacing="4" IsVisible="{Binding IsVolumeLevel}">
          <TextBlock Text="Level (%)" Classes="h2" />
          <NumericUpDown Value="{Binding VolumeLevel}" Minimum="0" Maximum="100" Increment="1" />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding IsVolumeStep}">
          <TextBlock Text="Step (%)" Classes="h2" />
          <NumericUpDown Value="{Binding VolumeStep}" Minimum="1" Maximum="50" Increment="1" />
        </StackPanel>
      </StackPanel>

      <!-- Launch -->
      <StackPanel Spacing="6" IsVisible="{Binding IsPath}">
        <TextBlock Text="Path" Classes="h2" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox Grid.Column="0" Text="{Binding Path}" />
          <Button Grid.Column="1" Content="File…" Command="{Binding BrowseProgramCommand}" Margin="6,0,0,0" />
          <Button Grid.Column="2" Content="Folder…" Command="{Binding BrowseFolderCommand}" Margin="6,0,0,0" />
        </Grid>
        <StackPanel Spacing="6" IsVisible="{Binding IsProgram}">
          <TextBlock Text="Arguments" Classes="h2" />
          <TextBox Text="{Binding Arguments}" />
          <TextBlock Text="Working directory" Classes="h2" />
          <TextBox Text="{Binding WorkingDirectory}" />
          <CheckBox Content="Run as administrator" IsChecked="{Binding RunAsAdministrator}" />
        </StackPanel>
      </StackPanel>

      <!-- Website -->
      <StackPanel Spacing="6" IsVisible="{Binding IsUrl}">
        <TextBlock Text="URL" Classes="h2" />
        <TextBox Text="{Binding Url}" Watermark="https://" />
      </StackPanel>

      <!-- System -->
      <StackPanel Spacing="6" IsVisible="{Binding IsSystem}">
        <TextBlock Text="System command" Classes="h2" />
        <ComboBox ItemsSource="{Binding SystemCommands}" SelectedItem="{Binding SystemCommand}" HorizontalAlignment="Stretch" />
        <TextBlock Text="Shutdown, restart, hibernate and log off take effect immediately." Classes="hint" />
      </StackPanel>

      <!-- Folder -->
      <StackPanel Spacing="6" IsVisible="{Binding IsFolder}">
        <TextBlock Text="Page to open" Classes="h2" />
        <ComboBox ItemsSource="{Binding FolderTargets}" SelectedItem="{Binding FolderTarget}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:Page">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Create a new page" Command="{Binding CreateFolderPageCommand}" HorizontalAlignment="Stretch" />
        <TextBlock Text="New pages start with a Back key so you can always get out." Classes="hint" />
      </StackPanel>

      <!-- Profile -->
      <StackPanel Spacing="6" IsVisible="{Binding IsProfileTarget}">
        <TextBlock Text="Profile" Classes="h2" />
        <ComboBox ItemsSource="{Binding ProfileTargets}" SelectedItem="{Binding ProfileTarget}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:Profile">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Brightness -->
      <StackPanel Spacing="6" IsVisible="{Binding IsBrightness}">
        <TextBlock Text="Brightness action" Classes="h2" />
        <ComboBox ItemsSource="{Binding BrightnessCommands}" SelectedItem="{Binding BrightnessCommand}" HorizontalAlignment="Stretch" />
        <StackPanel Spacing="4" IsVisible="{Binding IsBrightnessLevel}">
          <TextBlock Text="Level" Classes="h2" />
          <ComboBox ItemsSource="{Binding BrightnessSteps}" SelectedItem="{Binding BrightnessLevel}" HorizontalAlignment="Stretch" />
        </StackPanel>
      </StackPanel>

      <!-- Monitoring -->
      <StackPanel Spacing="6" IsVisible="{Binding IsMonitor}">
        <TextBlock Text="Metric" Classes="h2" />
        <ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" HorizontalAlignment="Stretch" />
        <StackPanel Spacing="4" IsVisible="{Binding IsMonitorAitum}">
          <TextBlock Text="Aitum state variable" Classes="h2" />
          <TextBox Text="{Binding MetricArgument}" />
        </StackPanel>
        <TextBlock Text="The value is redrawn on the key at the refresh rate set in Settings." Classes="hint" />
      </StackPanel>

      <!-- Multi action -->
      <StackPanel Spacing="6" IsVisible="{Binding IsMultiAction}">
        <TextBlock Text="Steps" Classes="h2" />
        <TextBlock Text="{Binding StepsSummary}" Classes="hint" />
        <Button Content="Edit steps…" Command="{Binding EditStepsCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Delay -->
      <StackPanel Spacing="6" IsVisible="{Binding IsDelay}">
        <TextBlock Text="Delay (ms)" Classes="h2" />
        <NumericUpDown Value="{Binding DelayMs}" Minimum="0" Maximum="600000" Increment="50" />
      </StackPanel>

      <!-- OBS -->
      <StackPanel Spacing="6" IsVisible="{Binding IsObs}">
        <TextBlock Text="OBS command" Classes="h2" />
        <ComboBox ItemsSource="{Binding ObsCommands}" SelectedItem="{Binding ObsCommand}" HorizontalAlignment="Stretch" />

        <StackPanel Spacing="4" IsVisible="{Binding IsObsScene}">
          <TextBlock Text="Scene" Classes="h2" />
          <ComboBox ItemsSource="{Binding ObsScenes}" SelectedItem="{Binding ObsScene}" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsObsSource}">
          <TextBlock Text="Source" Classes="h2" />
          <ComboBox ItemsSource="{Binding ObsSources}" SelectedItem="{Binding ObsSource}" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsObsFilter}">
          <TextBlock Text="Filter" Classes="h2" />
          <ComboBox ItemsSource="{Binding ObsFilters}" SelectedItem="{Binding ObsFilter}" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsObsTransition}">
          <TextBlock Text="Transition" Classes="h2" />
          <ComboBox ItemsSource="{Binding ObsTransitions}" SelectedItem="{Binding ObsTransition}" HorizontalAlignment="Stretch" />
        </StackPanel>

        <Button Content="Reload lists from OBS" Command="{Binding RefreshObsCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Windows media session -->
      <StackPanel Spacing="6" IsVisible="{Binding IsMediaSession}">
        <TextBlock Text="Media command" Classes="h2" />
        <ComboBox ItemsSource="{Binding MediaSessionCommands}" SelectedItem="{Binding MediaSessionCommand}" HorizontalAlignment="Stretch" />
        <TextBlock Text="Controls whatever app currently owns the Windows media controls - Spotify, a browser tab, VLC. No accounts or setup needed."
                   Classes="hint" />
      </StackPanel>

      <!-- Spotify -->
      <StackPanel Spacing="6" IsVisible="{Binding IsSpotify}">
        <TextBlock Text="Spotify command" Classes="h2" />
        <ComboBox ItemsSource="{Binding SpotifyCommands}" SelectedItem="{Binding SpotifyCommand}" HorizontalAlignment="Stretch" />

        <StackPanel Spacing="4" IsVisible="{Binding IsSpotifyUri}">
          <TextBlock Text="Playlist, album or track URI" Classes="h2" />
          <TextBox Text="{Binding SpotifyUri}" Watermark="spotify:playlist:37i9dQZF1DXcBWIGoYBM5M" />
          <TextBlock Text="In Spotify, right-click an item and choose Share → Copy Spotify URI." Classes="hint" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsSpotifyVolume}">
          <TextBlock Text="Volume (%)" Classes="h2" />
          <NumericUpDown Value="{Binding VolumeLevel}" Minimum="0" Maximum="100" Increment="1" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsSpotifyStep}">
          <TextBlock Text="Step (%)" Classes="h2" />
          <NumericUpDown Value="{Binding VolumeStep}" Minimum="1" Maximum="50" Increment="1" />
        </StackPanel>

        <TextBlock Text="Playback control needs Spotify Premium and an active device. Connect the account in Settings → Spotify."
                   Classes="hint" />
      </StackPanel>

      <CheckBox Content="Show album art on the key" IsChecked="{Binding ShowArtwork}" IsVisible="{Binding IsArtworkCapable}" />

      <!-- Twitch -->
      <StackPanel Spacing="6" IsVisible="{Binding IsTwitch}">
        <TextBlock Text="Twitch command" Classes="h2" />
        <ComboBox ItemsSource="{Binding TwitchCommands}" SelectedItem="{Binding TwitchCommand}" HorizontalAlignment="Stretch" />

        <StackPanel Spacing="4" IsVisible="{Binding IsTwitchText}">
          <TextBlock Text="{Binding TwitchTextLabel}" Classes="h2" />
          <TextBox Text="{Binding TwitchText}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsTwitchCommercial}">
          <TextBlock Text="Ad length (seconds)" Classes="h2" />
          <NumericUpDown Value="{Binding TwitchCommercialSeconds}" Minimum="30" Maximum="180" Increment="30" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsTwitchSlowMode}">
          <TextBlock Text="Slow mode delay (seconds)" Classes="h2" />
          <NumericUpDown Value="{Binding TwitchSlowModeSeconds}" Minimum="3" Maximum="120" Increment="1" />
        </StackPanel>

        <TextBlock Text="Connect the channel in Settings → Twitch." Classes="hint" />
      </StackPanel>

      <!-- Aitum -->
      <StackPanel Spacing="6" IsVisible="{Binding IsAitumRule}">
        <TextBlock Text="Aitum rule" Classes="h2" />
        <ComboBox ItemsSource="{Binding AitumRules}" SelectedItem="{Binding AitumRule}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="aitum:AitumRule">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Reload rules from Aitum" Command="{Binding RefreshAitumCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsAitumState}">
        <TextBlock Text="Aitum state variable" Classes="h2" />
        <ComboBox ItemsSource="{Binding AitumStates}" SelectedItem="{Binding AitumStateName}" HorizontalAlignment="Stretch" />
        <Button Content="Reload state from Aitum" Command="{Binding RefreshAitumCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <!-- Appearance -->
      <Separator Margin="0,14,0,6" />
      <TextBlock Text="Appearance" Classes="h1" />

      <TextBlock Text="Title" Classes="h2" />
      <TextBox Text="{Binding Title}" />
      <CheckBox Content="Show the title on the key" IsChecked="{Binding ShowTitle}" />

      <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
          <TextBlock Text="Size" Classes="h2" />
          <NumericUpDown Value="{Binding TitleSize}" Minimum="8" Maximum="40" Increment="1" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
          <TextBlock Text="Position" Classes="h2" />
          <ComboBox ItemsSource="{Binding TitlePositions}" SelectedItem="{Binding TitlePosition}" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
        <CheckBox Content="Bold" IsChecked="{Binding TitleBold}" />
        <CheckBox Content="Outline" IsChecked="{Binding TitleOutline}" />
      </StackPanel>

      <TextBlock Text="Title colour" Classes="h2" />
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" Margin="0,0,8,0"
                BorderBrush="#FF3A3A44" BorderThickness="1"
                Background="{Binding TitleColor, Converter={StaticResource HexBrush}}" />
        <TextBox Grid.Column="1" Text="{Binding TitleColor}" Watermark="#FFFFFFFF" />
      </Grid>

      <TextBlock Text="Background colour" Classes="h2" />
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" Margin="0,0,8,0"
                BorderBrush="#FF3A3A44" BorderThickness="1"
                Background="{Binding BackgroundColor, Converter={StaticResource HexBrush}}" />
        <TextBox Grid.Column="1" Text="{Binding BackgroundColor}" Watermark="#FF101014" />
      </Grid>

      <TextBlock Text="Icon" Classes="h2" />
      <ComboBox ItemsSource="{Binding Icons}" SelectedItem="{Binding SelectedIcon}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IconDescriptor">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Text="Icon colour" Classes="h2" />
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" Margin="0,0,8,0"
                BorderBrush="#FF3A3A44" BorderThickness="1"
                Background="{Binding IconTint, Converter={StaticResource HexBrush}}" />
        <TextBox Grid.Column="1" Text="{Binding IconTint}" Watermark="#FFFFFFFF" />
      </Grid>

      <TextBlock Text="Custom image" Classes="h2" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Choose…" Command="{Binding ChooseImageCommand}" />
        <Button Content="Remove" Command="{Binding ClearImageCommand}" IsEnabled="{Binding HasCustomImage}" />
      </StackPanel>
      <TextBlock Text="{Binding ImageFile}" Classes="hint" />

      <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
          <TextBlock Text="Fit" Classes="h2" />
          <ComboBox ItemsSource="{Binding IconFits}" SelectedItem="{Binding IconFit}" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
          <TextBlock Text="Scale" Classes="h2" />
          <Slider Value="{Binding IconScale}" Minimum="0.1" Maximum="1.0" TickFrequency="0.05" />
        </StackPanel>
      </Grid>

    </StackPanel>
  </ScrollViewer>

</UserControl>
