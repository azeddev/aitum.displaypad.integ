<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenBaseCamp.App.Views.ConfirmWindow"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="OpenBaseCamp">

  <StackPanel Margin="20" Spacing="14">
    <TextBlock Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button Content="Delete" Click="OnAccept" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
